# Copy this file to .env for local runs (never commit the real .env --
# it's already in .gitignore). For the scheduled GitHub Actions run, these
# same values go into the repo's "Secrets" settings instead -- see README.

# From developer.ebay.com -> your application's keys (production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# From reverb.com -> account settings -> API access
REVERB_API_TOKEN=
